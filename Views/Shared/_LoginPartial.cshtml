@using Microsoft.AspNetCore.Identity
@using NoteConnect.Models.Entities
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<ul class="navbar-nav account-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link account-icon"
               asp-controller="User"
               asp-action="Index"
               title="Profile"
               aria-label="Profile">
                <i class="bi bi-person"></i>
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link account-icon"
               asp-area="Identity"
               asp-page="/Account/Manage/ChangePassword"
               title="Settings"
               aria-label="Settings">
                <i class="bi bi-gear"></i>
            </a>
        </li>

        <li class="nav-item">
            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit"
                        class="nav-link account-icon"
                        title="Logout"
                        aria-label="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-page="/Account/Register">
                Register
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-page="/Account/Login">
                Login
            </a>
        </li>
    }
</ul>