@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid">
    <div class="text-center row">
        <h1 class="display-4 mt-3">NoteConnect Demo</h1>
        <p>A collaborative notetaking platform for students, by students.</p>
    </div>
    <br />
    <div class="row">
        <div class="col-8 ms-3">
            <h3 class="mb-2">About the App</h3>
            <p class="fs-5">NoteConnect is a platform that allows students to collaborate on notes, organize them into notebooks, and access their account details seamlessly. The notes feature a rich text editor for easy formatting and organization, and can be stored in notebooks. The notebooks act as containers for organizing and managing multiple notes efficiently. Users can also invite collaborators to their notebooks for enhanced teamwork.</p>
            <p class="fs-5">NoteConnect also allows users to create accounts through the platform directly or through Google.To access these features, users can navigate through the platform using the intuitive interface. We hope you enjoy using NoteConnect!</p>
            <h3 class="mb-2">Contributors</h3>
