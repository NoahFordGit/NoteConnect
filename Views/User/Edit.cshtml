@using NoteConnect.ViewModels
@model UserViewModel


@{
    ViewData["Title"] = "Edit Profile";
}

<h2 class="display-5 text-center p-3"><strong>Edit Profile</strong></h2>

<div class="align-middle ms-4 me-4">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="UserId" />

        <div class="form-group mb-3">
            <label>First Name</label>
            <input name="FirstName" value="@Model.FirstName" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label>Last Name</label>
            <input name="LastName" value="@Model.LastName" class="form-control" />
        </div>
        
        <div class="form-group mb-3">
            <label>Username</label>
            <input name="UserName" value="@Model.UserName" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label>Email</label>
            <input name="Email" value="@Model.Email" class="form-control" type="email" />
        </div>

        <div class="form-group mb-3">
            <label>Phone Number</label>
            <input name="PhoneNumber" value="@Model.PhoneNumber" class="form-control" type="tel" />
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Save <i class="bi bi-save"></i></button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>