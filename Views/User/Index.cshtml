@using NoteConnect.ViewModels
@model UserViewModel

@{
    ViewData["Title"] = "Profile";
    var hasPassword = Model.HasPassword;
}

<div class="container-fluid">
    <h1 class="display-5 text-center mt-4 mb-3"><strong>User Profile</strong></h1>


    <div class="table-responsive shadow p-3 mt-3 mb-5 bg-body rounded ms-4 me-4">
        <table class="table align-middle">
            <tr><th>Username</th><td>@Model.UserName</td></tr>
            <tr><th>Email</th><td>@Model.Email</td></tr>
            <tr><th>First Name</th><td>@Model.FirstName</td></tr>
            <tr><th>Last Name</th><td>@Model.LastName</td></tr>
            <tr><th>Date Created</th><td>@Model.DateGiven.ToString("MMM d, yyyy")</td></tr>
        </table>
    </div>
    <div class="align-middle ms-4 me-4">
        <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-primary">Edit <i class="bi bi-pencil-fill"></i></a>
        <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword" class="btn btn-info">@(hasPassword ? "Change Password" : "Set password")</a>
        <a asp-area="Identity" asp-page="/Account/Manage/ExternalLogins" class="btn btn-warning">Manage Google Sign-in <i class="bi bi-google"></i></a>
        
        <form asp-action="Delete" asp-route-id="@Model.UserId" method="post" style="display:inline;">
            <button type="submit" class="btn btn-danger" onclick="return confirm('Delete your account?')">Delete <i class="bi bi-trash"></i></button>
        </form>
    </div>

    @if (!hasPassword)
    {
        <p class="mt-3">Set a NoteConnect password to sign in with your email and password as well as Google. Your Google sign-in will continue to work.</p>
    }

</div>