@using NoteConnect.Models.Entities
@model User
@inject Microsoft.AspNetCore.Identity.UserManager<User> UserManager

@{
    ViewData["Title"] = "Profile";
    var hasPassword = await UserManager.HasPasswordAsync(Model);
}

<h1>User Index</h1>


<table class="table">
        <tr><th>Username</th><td>@Model.UserName</td></tr>
        <tr><th>Email</th><td>@Model.Email</td></tr>
        <tr><th>First Name</th><td>@Model.FirstName</td></tr>
        <tr><th>Last Name</th><td>@Model.LastName</td></tr>
        <tr><th>Date Created</th><td>@Model.DateCreated.ToString("MMM d, yyyy")</td></tr>
</table>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
<a asp-area="Identity" asp-page="/Account/Manage/ChangePassword" class="btn btn-outline-primary">@(hasPassword ? "Change password" : "Set password")</a>
<a asp-area="Identity" asp-page="/Account/Manage/ExternalLogins" class="btn btn-outline-primary">Manage Google sign-in</a>

@if (!hasPassword)
{
    <p class="mt-3">Set a NoteConnect password to sign in with your email and password as well as Google. Your Google sign-in will continue to work.</p>
}

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;">
    <button type="submit" class="btn btn-danger" onclick="return confirm('Delete your account?')">Delete</button>
</form>
