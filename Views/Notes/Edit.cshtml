@model Note
@{
    ViewData["Title"] = "Edit Note";
}

<h1 class="display-5 text-center p-3"><strong>Edit Note</strong></h1>

<form class="align-middle ms-4 me-4" asp-action="Edit" asp-route-id="@Model.NoteId" method="post">
    <partial name="_NoteForm" model="Model" />
    <button asp-route-id="@Model.NoteId" type="submit" class="btn btn-primary">Save Changes <i class="bi bi-save"></i></button>
    <a asp-action="Details" asp-route-id="@Model.NoteId" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

    <script src="~/js/note-editor.js" asp-append-version="true"></script>
}
