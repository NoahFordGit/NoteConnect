@model Note

<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

<div class="mb-3">
    <label asp-for="NoteTitle" class="form-label">Title</label>
    <input asp-for="NoteTitle" class="form-control" required />
    <span asp-validation-for="NoteTitle" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="NotebookId" class="form-label">Notebook</label>
    <select asp-for="NotebookId" asp-items="ViewBag.Notebooks" class="form-select">
        <option value="">No notebook</option>
    </select>
    <span asp-validation-for="NotebookId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Content" class="form-label">Content</label>

    <div id="note-editor" style="height: 350px;"></div>

    <input type="hidden" asp-for="Content" id="note-content" />

    <span asp-validation-for="Content" class="text-danger"></span>
</div>
