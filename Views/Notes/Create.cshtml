@model Note
@{
    ViewData["Title"] = "Create Note";
}

<h1 class="display-5 text-center p-3"><strong>Create Note</strong></h1>

<form class="align-middle ms-4 me-4" asp-action="Create" method="post">
    
    <partial name="_NoteForm" model="Model" />
    <button type="submit" class="btn btn-primary">Save <i class="bi bi-save"></i></button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

    <script src="~/js/note-editor.js" asp-append-version="true"></script>

}
