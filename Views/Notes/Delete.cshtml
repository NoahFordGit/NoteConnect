@model Note
@{
    ViewData["Title"] = "Delete note";
}

<h1 class="display-5 text-center p-3"><strong>Delete Note</strong></h1>
<p class="ms-4 fs-5">Are you sure you want to delete <strong class="text-break">@Model.NoteTitle</strong>? This cannot be undone.</p>

<form class="ms-4" asp-action="Delete" asp-route-id="@Model.NoteId" method="post">
    <button asp-action="Index" type="submit" class="btn btn-danger">Delete Note <i class="bi bi-trash3"></i></button>
    <a asp-action="Details" asp-route-id="@Model.NoteId" class="btn btn-secondary">Cancel</a>
</form>
