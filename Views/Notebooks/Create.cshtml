@using NoteConnect.ViewModels
@model NotebookViewModel
@{
    ViewData["Title"] = "Create Notebook";
}

<h1 class="display-5 text-center p-3"><strong>Create Notebook</strong></h1>

<form class="align-middle ms-4 me-4" asp-action="Create" method="post">
    <partial name="_NotebookForm" model="Model" />
    <button type="submit" class="btn btn-primary">Save <i class="bi bi-save"></i></button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
