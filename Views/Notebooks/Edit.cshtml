@using NoteConnect.ViewModels
@model NotebookViewModel
@{
    ViewData["Title"] = "Edit Notebook";
}

<h1 class="display-5 text-center p-3"><strong>Edit Notebook</strong></h1>

<form class="align-middle ms-4 me-4" asp-action="Edit" asp-route-id="@Model.NotebookId" method="post">
    <partial name="_NotebookForm" model="Model" />
    <button type="submit" class="btn btn-primary">Save Changes <i class="bi bi-save"></i></button>
    <a asp-action="Details" asp-route-id="@Model.NotebookId" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
