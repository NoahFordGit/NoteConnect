@model Notebook

<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

<div class="row mb-3 align-items-center">
    <label asp-for="NotebookName" class="col-auto col-form-label fs-5">Notebook Title:</label>
    <div class="col-5">
        <input asp-for="NotebookName" class="form-control" maxlength="100" required />
        <span asp-validation-for="NotebookName" class="text-danger"></span>
    </div>
</div>

<div class="col mb-3 align-items-center">
    <label asp-for="Description" class="col-auto col-form-label fs-5">Description (optional):</label>
    <div class="row mb-3">
        <textarea asp-for="Description" class="col-form-label ms-2 w-75" rows="4" maxlength="500"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
</div>
